VITE_API_URL=http://localhost:3000

# Login com Google (18-11-2026): o ID do cliente OAuth do Google Cloud (tipo "Aplicativo da Web"). Não é segredo: vai
# para o navegador de qualquer jeito, dentro do botão do Google. Sem ele (vazio ou ausente), o botão "Continuar com o
# Google" não aparece no login nem no cadastro. Precisa ser o MESMO valor de GOOGLE_CLIENT_ID no nest/.env, e o
# endereço do site precisa estar nas "Origens JavaScript autorizadas" do cliente no Google Cloud.
VITE_GOOGLE_CLIENT_ID=708103851956-atovt28j2m2h3ek5fhm74nd9sesn87fk.apps.googleusercontent.com
