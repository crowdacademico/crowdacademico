{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [
            ".dto.ts",
            ".request-close-campaign.ts",
            ".request-confirm-upload.ts",
            ".request-create-for-other.ts",
            ".request-create.ts",
            ".request-fix-cpf.ts",
            ".request-forgot-password.ts",
            ".request-list.ts",
            ".request-login.ts",
            ".request-refresh-token.ts",
            ".request-register.ts",
            ".request-reject.ts",
            ".request-reset-password.ts",
            ".request-shift-dates.ts",
            ".request-start-upload.ts",
            ".request-update.ts",
            ".request-verify-email.ts",
            ".response.ts",
            ".response-accepted-term.ts",
            ".response-active.ts",
            ".response-export-data.ts",
            ".response-login-history.ts",
            ".response-login.ts",
            ".response-register.ts",
            ".response-score.ts",
            ".response-summary.ts",
            ".response-upload-started.ts"
          ]
        }
      }
    ]
  }
}
