# ============================================================================
# nest/.env.example - copie para nest/.env e preencha. O .env nunca vai para o git.
# Todo valor abaixo é exemplo ou lacuna: nenhum segredo real mora neste arquivo.
# ============================================================================

# ---------------------------------------------------------------------------
# Banco e servidor
# ---------------------------------------------------------------------------
# Conexão como app_nestjs (NUNCA postgres): é isso que faz a RLS valer. Se o Nest subir conectado como outro
# usuário, ele se recusa a iniciar (DatabaseModule.onModuleInit). Supabase: Project Settings > Database > pooler.
DATABASE_URL=postgresql://app_nestjs:SENHA@HOST:6543/postgres
PORT=3000

# Limites do pool de conexões (todos opcionais; valor inválido faz o boot falhar). Antes não havia nenhum limite de
# espera: pool esgotado virava requisição pendurada para sempre.
#   DB_POOL_MAX                    clients simultâneos (padrão 10). Cada requisição comum prende UM do começo ao fim.
#   DB_POOL_IDLE_TIMEOUT_MS        fecha client ocioso depois disso (padrão 30000)
#   DB_POOL_CONNECTION_TIMEOUT_MS  quanto esperar por um client livre antes de dar erro (padrão 10000)
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Só usada por nest/src/commons/database/aplicar-migrations.script.ts (hoje sem uso na prática). Precisa de uma
# credencial com privilégio de DDL, a mesma que você usa no SQL Editor. Nunca a mesma da app_nestjs.
DATABASE_URL_MIGRATIONS=

# ---------------------------------------------------------------------------
# Autenticação e dados sensíveis
# ---------------------------------------------------------------------------
# Segredo de assinatura do token de acesso. Frase longa e aleatória.
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
# Duração do token de acesso (formato do pacote "ms": 15m, 1h). Se faltar, vale 15m.
JWT_ACCESS_EXPIRES_IN=15m

# CPF do pesquisador: cifrado (AES-256-GCM) e com índice cego (HMAC) para busca. As DUAS chaves são obrigatórias
# (sem elas o perfil de pesquisador quebra) e precisam ser DIFERENTES entre si. Qualquer frase serve: a chave de
# cifra passa por SHA-256 antes de ser usada. Se trocar depois, os CPFs já gravados deixam de decifrar.
CPF_ENCRYPTION_KEY=
CPF_INDEX_KEY=

# ---------------------------------------------------------------------------
# Armazenamento de arquivos (módulo 25-arquivo, commons/storage)
# ---------------------------------------------------------------------------
# Provedor ATUAL: Supabase Storage (bucket S3-compatível), no mesmo projeto do banco. Nenhuma conta nova, nenhuma
# taxa. A mesma implementação (S3CompativelArmazenamentoService) também serve Cloudflare R2, AWS S3, Backblaze B2 ou
# MinIO: trocar de provedor é só preencher estas variáveis de novo, sem mudar código.
#
# Criar o bucket: painel do Supabase > Storage > New bucket. Dê um nome (ex.: crowdacademico-arquivos) e marque
# "Public bucket" na criação, o que já libera leitura pública sem mexer em política depois.
#
# Onde achar cada valor:
# - STORAGE_ENDPOINT: Storage > S3 > "Endpoint" (termina em /storage/v1/s3).
# - STORAGE_ACCESS_KEY_ID e STORAGE_SECRET_ACCESS_KEY: Storage > S3 > "Access keys" > New access key. Copie os dois
#   na hora para este .env: fechando a tela sem copiar a secret, não há como ver de novo, só apagar a chave e criar
#   outra (e qualquer serviço que use a chave antiga quebra).
# - STORAGE_BUCKET: o nome do bucket.
# - STORAGE_PUBLIC_BASE_URL: domínio público de leitura. No Supabase é
#   https://<ref-do-projeto>.supabase.co/storage/v1/object/public/<nome-do-bucket>. Em produção, o recomendado é um
#   domínio próprio (ex.: arquivos.crowdacademico.com.br) apontando para o bucket. NUNCA o domínio principal do site.
STORAGE_ENDPOINT=https://REF-DO-PROJETO.storage.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=crowdacademico-arquivos
STORAGE_PUBLIC_BASE_URL=https://REF-DO-PROJETO.supabase.co/storage/v1/object/public/crowdacademico-arquivos
STORAGE_REGION=us-east-2
# Só mude para false se um endpoint específico exigir virtual-hosted style.
STORAGE_FORCE_PATH_STYLE=true

# Lembretes de infraestrutura (configurados no painel do provedor, não em código):
# 1. O bucket é PÚBLICO (leitura) e servido por um domínio SEPARADO do site (arquivos.<dominio>, nunca
#    <dominio>/arquivos): se algo malicioso escapar, ele não roda "de dentro" do site nem alcança cookies ou a sessão.
# 2. Regra de ciclo de vida (lifecycle rule) apagando tudo em "pendente/" com mais de 24h. Substitui um job de
#    limpeza de órfãos inteiro (ver commons/storage/storage.constants.ts).
# 3. A lista de tipos aceitos é fechada no código (25-arquivo/arquivo.constants.ts: JPEG, PNG, WebP, PDF). SVG nunca
#    entra, porque pode conter script embutido.



# =====================================================================================================================
# MODELO DE VARIÁVEIS DO ASAAS (PAYMENT_PROVIDER=asaas). COPIE as linhas que precisar para o seu nest/.env e preencha.
# Este arquivo NÃO contém credenciais e pode ir para o git. O nest/.env (com os valores reais) NUNCA vai para o git, e nenhum
# destes valores deve ser colado em chat, issue ou log.
# A explicação completa de cada campo também está em src/29-pagamento/adapters/asaas/asaas.config.ts.
# Se algo estiver errado ou faltando, o sistema RECUSA SUBIR e escreve na tela exatamente o que corrigir.
# =====================================================================================================================

# --- 1. Liga o Asaas -------------------------------------------------------------------------------------------------
# "asaas" usa o Asaas de verdade. "fake" (padrão em desenvolvimento) usa um gateway de mentira em memória, sem rede.
PAYMENT_PROVIDER=asaas

# --- 2. Ambiente -----------------------------------------------------------------------------------------------------
# sandbox    = ambiente de TESTES do Asaas (conta e dinheiro de mentira). Comece por aqui.
# production = dinheiro REAL. Em produção (NODE_ENV=production) este campo é obrigatório.
# Sandbox e produção são contas separadas; a chave de um NÃO funciona no outro.
ASAAS_ENV=sandbox

# --- 3. Chave de API (SECRETA) ---------------------------------------------------------------------------------------
# Onde pegar: painel do Asaas (do ambiente escolhido acima) > menu do usuário > Integrações > Chaves de API > Gerar nova chave.
# O Asaas mostra a chave UMA ÚNICA VEZ: copie na hora. Sandbox começa com $aact_hmlg_ ; produção com $aact_prod_.
# O "$" FAZ PARTE da chave: escreva SEMPRE ENTRE ASPAS SIMPLES, como abaixo.
# Se vazar: revogue no mesmo painel e gere outra.
ASAAS_API_KEY='$aact_hmlg_COLE_AQUI_A_CHAVE_DO_SANDBOX'

# --- 4. Senha do webhook (você inventa) ------------------------------------------------------------------------------
# Texto longo e aleatório, de 32 a 255 caracteres. Gere com:  openssl rand -hex 32
# Cole O MESMO valor no painel do Asaas: Integrações > Webhooks > "Token de autenticação".
# Configure o webhook no Asaas assim:
#   URL:    https://SEU-DOMINIO/pagamento/webhook/asaas
#   Eventos: PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE, PAYMENT_DELETED, PAYMENT_REFUNDED,
#            PAYMENT_PARTIALLY_REFUNDED, TRANSFER_DONE, TRANSFER_FAILED, TRANSFER_CANCELLED
#   Tipo de envio: sequencial
ASAAS_WEBHOOK_TOKEN=COLE_AQUI_UM_TEXTO_ALEATORIO_DE_NO_MINIMO_32_CARACTERES

# --- 5. Senha da validação de saque (recomendado; você inventa) ------------------------------------------------------
# Com a "validação de saque por webhook" ligada no Asaas (Integrações > Mecanismos de segurança), o Asaas pergunta ao sistema
# antes de executar CADA transferência, e o sistema só aprova a que corresponde a um repasse dele. Isso impede que uma chave de
# API vazada tire dinheiro da conta. Gere outro texto aleatório (mín. 32 caracteres), cole no campo de token dessa tela e aqui.
#   URL: https://SEU-DOMINIO/pagamento/webhook/asaas/autorizacao-saque
# NÃO marque a opção "autorização de saque para estornos Pix" (as devoluções não passam por essa validação e seriam recusadas).
# Se você deixar em branco, vale o ASAAS_WEBHOOK_TOKEN.
ASAAS_SAQUE_TOKEN=

# --- 6. Cliente genérico das contribuições ---------------------------------------------------------------------------
# O Asaas exige um "cliente" em toda cobrança, e as contribuições aqui podem ser anônimas: todas usam UM cliente genérico.
# Crie UMA VEZ (em cada ambiente): painel do Asaas > Clientes > Novo cliente. Sugestão: nome "Apoiador CrowdAcadêmico", com o
# CPF/CNPJ que o painel pedir, e DESLIGUE as notificações desse cliente (senão o Asaas manda e-mail a cada contribuição).
# O código que aparece no cliente criado, no formato cus_000000000000, é o valor abaixo.
ASAAS_CUSTOMER_ID=cus_COLE_AQUI_O_ID_DO_CLIENTE

# --- Opcionais (pode apagar estas linhas; os valores abaixo já são os padrões) ---------------------------------------
# Nome da aplicação enviado ao Asaas (o cabeçalho User-Agent é obrigatório lá). Sem espaços nem acentos.
ASAAS_USER_AGENT=CrowdAcademico
# Quanto esperar (em milissegundos) por uma resposta do Asaas antes de tratar como falha de rede.
ASAAS_TIMEOUT_MS=20000
# Quantas páginas de 100 transferências recentes olhar antes de pedir uma nova (evita transferir o mesmo repasse duas vezes).
ASAAS_BUSCA_TRANSFERENCIA_PAGINAS=3
# Só para testes: troca a URL da API (ex.: um servidor de mentira local). Deixe em branco normalmente.
ASAAS_BASE_URL=

# --- Opcionais dos workers (padrões entre parênteses) -----------------------------------------------------------------
# ESTORNO_LOTE_MAXIMO=50          devoluções por ciclo de 5 min
# ESTORNO_TIMEOUT_GATEWAY_MS=30000
# REPASSE_LOTE_MAXIMO=20          repasses por ciclo de 5 min
# REPASSE_TIMEOUT_GATEWAY_MS=30000
# RECONCILIACAO_LOTE=50           cobranças reconsultadas/canceladas por ciclo de 10 min
